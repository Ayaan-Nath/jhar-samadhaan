# PostgreSQL connection used by every API route (shared pool in lib/db.ts).
# Requires the pgvector extension (see db/schema.sql at the repo root).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/jhar_samadhan

# FastAPI triage microservice (Module 2) — optional at runtime; intake and
# dedupe degrade gracefully when unreachable.
SBERT_SERVICE_URL=http://localhost:8000/api/v1/embed

# Optional tunables (see route headers for defaults)
# DEDUPE_WINDOW_DAYS=90
